{
  "name": "interview-copilot",
  "version": "0.2.0",
  "private": true,
  "description": "A resume-aware interview practice agent powered by Go, Eino and Electron.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:renderer": "tsc -b && vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:renderer && npm run build:server",
    "dist": "npm run build && electron-builder",
    "test": "go test ./... && npm run build:renderer",
    "format": "gofmt -w cmd internal && tsc -b --pretty false"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "lucide-react": "1.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "42.4.1",
    "electron-builder": "26.8.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "wait-on": "9.0.4"
  },
  "build": {
    "appId": "com.interviewcopilot.desktop",
    "productName": "Interview Copilot",
    "asar": true,
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [{"from": "resources/bin", "to": "bin"}],
    "mac": {"category": "public.app-category.education", "target": ["dmg", "zip"]},
    "win": {"target": ["nsis"]},
    "linux": {"target": ["AppImage"]}
  }
}
